programa {
  funcao inicio() {
    real kWh, valor, w, horas, dias
    cadeia taxa

    escreva("A potência em Watts", "\n")
    leia(w)
    escreva("Quantas horas por dia?", "\n")
    leia(horas)
    escreva("Quantas dias do mês?")
    leia(dias)
    escreva("O valor cobrado em kWh")
    leia(kWh)
  }
}
