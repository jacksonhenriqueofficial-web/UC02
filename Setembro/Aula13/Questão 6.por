programa {
  funcao inicio() {
    /*
    declarção: valorpago, valorCompra, troco
    entrada: valorpago = 50.00
             valorCompra = 37.50

    Processamento: troco = valorpago - valorCompra

    saída: escreva("troco: R$ ", troco, "\n")

    Saída final: Troco: R$ 12.50
    */
    real valorpago, valorCompra, troco
    valorpago = 50.00
    valorCompra = 37.50
    troco = valorpago - valorCompra
    escreva("troco: R$ ", troco, "\n")
  }
}
