programa {
  funcao inicio() {
    //declaração 
    real precoLitro, litro, total

    //entrada
    escreva("Preço total do litro da gasolina em Maceió", "\n")
    leia(precoLitro)
    escreva("Quantos litros você abasteceu?", "\n")
    leia(litro)
    //processamento
    total = precoLitro * litro
    //saída
    escreva("Total a pagar é: ", total, "\n")

    //O algoritmo segue todas as convenções
  }
}
