programa {
  funcao inicio() {
    real valorDoacai, divisaodosamigos
    inteiro quantidadedeamigos = 3
    
    escreva("Valor do açaí proposto: ", "\n")
    leia(valorDoacai)
    divisaodosamigos = valorDoacai / quantidadedeamigos
    escreva("este é o valor que vocês irão pagar: ", divisaodosamigos)
    
    
    

  }
}
