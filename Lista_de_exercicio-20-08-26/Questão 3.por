programa {
  funcao inicio() {
    real valorDopasseio, divisaodosamigos
    inteiro quantidadedeamigos = 4
    
    escreva("Valor do passeio proposto: ", "\n")
    leia(valorDopasseio)
    divisaodosamigos = valorDopasseio / quantidadedeamigos
    escreva("este é o valor que vocês irão pagar: ", divisaodosamigos)
    
    
    

  }
}
