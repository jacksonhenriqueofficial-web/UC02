programa {
  funcao inicio() {
    real faturamento, vendidos
    const inteiro picole = 2
    escreva("--------------------Receita hoje----------------------", "\n")
  
  
    escreva("\n", "picole vendidas: ")
    leia(vendidos)

    faturamento = picole*vendidos
    escreva("O total receita de hoje foi: R$", faturamento)
  }
}
