programa {
  funcao inicio() {
  
    escreva("1º Questão", "\n")
    escreva("Hello World", "\n")
    
    escreva("2º Questão", "\n")
    cadeia nome1
    escreva("Qual o seu nome?", "\n")
    leia(nome1)
    escreva("Olá ", nome1, ", é um prazer em conhecer!", "\n")
    
    escreva("3º Questão", "\n")
    cadeia nome2 
    real salario 
    escreva("Qual seu nome?", "\n")
    leia(nome2)
    escreva("Escreva seu salario", "\n")
    leia(salario)
    escreva("Nome do funcionario:", nome2, "\n")
    escreva("Salário:", salario, "\n")
    
    escreva("4º Questão", "\n")
    inteiro numero1, numero2
    
    escreva("Escreva seu primeiro número: ", "\n")
    leia(numero1)
    escreva("Escreva seu segundo número: ", "\n")
    leia(numero2)
    escreva("Seu resultado é: ", numero1 + numero2, "\n")
    

    




    
  }
}
