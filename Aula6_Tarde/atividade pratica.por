programa {
  funcao inicio() {
    escreva("              Hello World", "\n")
    escreva("-------------- MALDIÇÃO 4 --------------", "\n")
    cadeia nome = "artur calebe"
    inteiro idade = 17
    caracter sexo = 'M'
    logico status = verdadeiro 
    real salario = 350.00
    real calculo = (5 + 7) / 2 
    escreva(
      "Nome: ", nome, "\n",
      "Idade: ", idade, "\n",
      "Sexo: ", sexo, "\n",
      "Status", status, "\n",
      "Salario", salario, "\n",
      "O resultado é: ", calculo
    )
  }
}
